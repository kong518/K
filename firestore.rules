rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Validation Blueprint
    function isValidRecord(data) {
      return data.keys().hasAll(['title', 'disabilityTypes', 'completed', 'userId', 'userName', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 7 && data.keys().size() <= 9 // Including optional 'content' and 'userPhoto'
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.userName is string && data.userName.size() <= 100
        && (data.keys().hasAny(['userPhoto']) ? (data.userPhoto is string || data.userPhoto == null) : true)
        && data.disabilityTypes is list && data.disabilityTypes.size() <= 15
        && data.completed is bool
        && data.userId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId);
      
      allow list: if isSignedIn();

      allow create: if isSignedIn() 
        && isValidId(recordId)
        && isValidRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(existing().userId)
        && isValidId(recordId)
        && (
          // Action: Toggle Completed
          (incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt'])) ||
          // Action: Edit Record
          (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'disabilityTypes', 'updatedAt'])
           && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 500
           && incoming().disabilityTypes is list && incoming().disabilityTypes.size() <= 15)
        )
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && incoming().userId == existing().userId;

      allow delete: if isOwner(existing().userId) && isValidId(recordId);
    }
  }
}
