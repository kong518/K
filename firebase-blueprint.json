{
  "entities": {
    "ServiceRecord": {
      "title": "Service Record",
      "description": "A record of service or consultation for a person with disabilities.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Subject or name of the client" },
        "content": { "type": "string", "description": "Detailed record of the service" },
        "disabilityTypes": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Characteristics/types of disability select for this record" 
        },
        "completed": { "type": "boolean", "description": "Whether the follow-up is finished" },
        "userId": { "type": "string", "description": "The ID of the social worker who created this record" },
        "userName": { "type": "string", "description": "Display name of the creator" },
        "userPhoto": { "type": "string", "description": "Photo URL of the creator" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["title", "disabilityTypes", "completed", "userId", "userName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/records/{recordId}": {
      "schema": "ServiceRecord",
      "description": "Collection of service records."
    }
  }
}
